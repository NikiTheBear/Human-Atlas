  "questions": [
    {
      "id": "v16_q01",
      "type": "forced_choice",
      "stealth_mode": "normalization",
      "layer": "explicit",
      "mirror_key": "neuro_festival",
      "is_sensitive": false,
      "weight": 1.4,
      "context": "跨城看一场音乐节，散场时已经十一点半。人群从铁马口往外涌，耳朵里还留着一层嗡响，T 恤贴在背上，回酒店的地铁要坐十四站。",
      "prompt": "走出场地那两百米，你身上最先启动的是哪一样？",
      "options": [
        {
          "key": "A",
          "text": "耳机不戴，专挑人少的巷子走，让耳鸣自己退下去，谁说话都先不回",
          "effects": {
            "hsp_sensory": 1.8,
            "hss_intensity": -1.6,
            "big5_social": -1,
            "virtue_temperance": 0.7
          },
          "social_desirability": 2
