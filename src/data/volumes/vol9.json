          "text": "先弄清自己心里那道坎到底是什么：我究竟在哪一句上觉得被冒犯",
          "effects": {
            "jung_fi": 2,
            "jung_ti": -0.8,
            "val_moral": 0.9,
            "att_anxiety": 0.7
          },
          "social_desirability": 2
