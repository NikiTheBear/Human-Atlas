        {
          "key": "D",
          "text": "直接把规矩定下来：这类事以后再发生，谁负责哪一步，别又耗一整晚",
          "effects": {
            "jung_te": 2,
            "jung_fi": -0.8,
            "big5_order": 1.2,
            "big5_assert": 0.9
          },
          "social_desirability": 2
