            "phil_absurd": -1.2
          },
          "social_desirability": 2
        },
        {
          "key": "B",
          "text": "没有人承诺过剧本。旧的那本撕了，那就由我重写一版，写砸了也算我自己的",
          "effects": {
            "phil_existential": 2,
            "mot_autonomy": 1.4,
            "lv_anchor": 0.8,
            "phil_nihilism": -1.2
          },
          "social_desirability": 3
        },
        {
          "key": "C",
          "text": "推上去的东西总会滚下来。先笑一下，然后去吃一顿很烫很辣的东西",
          "effects": {
            "phil_absurd": 2,
            "phil_epicurean": 1.7,
            "lv_suffering": -1.2,
            "phil_stoic": -1.2
          },
          "social_desirability": 1
        },
        {
          "key": "D",
          "text": "认真到这个地步还是被这样拿走，以后别再把整颗心押在任何一件事上",
          "effects": {
            "phil_cynic": 2,
            "phil_nihilism": 1.4,
            "light_faith": -1.4,
            "lv_suffering": -0.8
          },
          "social_desirability": 0
        }
      ]
    },
