        ]
      }
    },
    {
      "id": "v10_q03",
      "type": "forced_choice",
      "stealth_mode": "projection",
      "layer": "explicit",
      "mirror_key": "alignment_good",
      "is_sensitive": true,
      "weight": 1.4,
      "context": "你的一位老朋友失业三个月了，一直没跟家里说。今晚TA带你去TA女朋友家吃饭，饭桌上她随口说起TA最近总加班到很晚，TA笑着点头。",
      "prompt": "桌下TA的膝盖轻轻碰了碰你。你接下来那句话会往哪边走？",
      "options": [
        {
          "key": "A",
          "text": "顺着TA的话编圆，回头把这事记下来——下次TA开口借钱，我有依据。",
          "effects": {
            "dd_order": -1.2,
            "dd_good": -1.2,
            "dark_mach": 1.1
          },
          "social_desirability": 0
        },
        {
          "key": "B",
          "text": "顺着TA说下去。这是TA的事，什么时候说是TA的权利，我只负责不当场拆台。",
          "effects": {
            "dd_order": -1.5,
            "dd_good": 1.8,
            "mot_belonging": 1.0
          },
          "social_desirability": 1
        },
        {
          "key": "C",
          "text": "照实说一句「TA最近没上班，具体你问TA」，剩下的交给TA自己。",
          "effects": {
            "dd_order": 1.9,
            "dd_good": -1.3,
            "light_kant": 1.1
          },
          "social_desirability": 2
        },
        {
          "key": "D",
          "text": "把话岔开，聊点别的。我没有撒谎，也不替TA决定哪一天该开口。",
          "effects": {
            "dd_order": 1.3,
            "dd_good": 1.4,
            "cog_ambiguity": 1.0
          },
          "social_desirability": 3
        }
      ]
    },
    {
      "id": "v10_q04",
      "type": "impulse_3s",
      "stealth_mode": "impulse",
      "layer": "stealth",
      "mirror_key": "alignment_good",
      "is_sensitive": true,
      "weight": 1.3,
      "context": "晚高峰的地铁站台，一个男人因为裤脚被拖把碰到，对着保洁阿姨越说越大声，手指几乎戳到她脸上。周围人都低头看手机。",
      "prompt": "你离他们只有三步，第一秒身体先做出的是——",
      "options": [
        {
          "key": "A",
          "text": "走过去站到阿姨侧前半步，一句话不说，就那么平视着TA。",
          "effects": {
            "dd_order": 1.2,
            "dd_good": 1.9,
            "big5_assert": 1.1
          },
          "social_desirability": 3
        },
        {
          "key": "B",
          "text": "先录下来再叫站台工作人员——没记录的事，最后就是各说各话。",
          "effects": {
            "dd_order": 1.9,
            "dd_good": -1.2,
            "big5_compliance": 0.9
          },
          "social_desirability": 2
        },
        {
          "key": "C",
          "text": "心里一紧，但把耳机音量调大，加快脚步走进车门。",
          "effects": {
            "dd_order": -1.2,
            "dd_good": -1.5,
            "def_detach": 1.1
          },
          "social_desirability": 1
        },
        {
          "key": "D",
          "text": "直接开口：「人家拖地，你的鞋挡着道了」，语气比TA还冲。",
          "effects": {
            "dd_order": -1.3,
            "dd_good": 1.3,
            "sin_wrath": 1.2
          },
          "social_desirability": 0
        }
      ]
    },
    {
