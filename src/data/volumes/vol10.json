    {
      "id": "v10_q06",
      "type": "forced_choice",
      "stealth_mode": "ipsative",
      "layer": "explicit",
      "mirror_key": "alignment_order",
      "is_sensitive": true,
      "weight": 1.4,
      "context": "公司内网的考勤系统有个谁都知道、也没人修的漏洞：补卡申请可以自己审批。这个月你迟到过三次，其中两次确实是自己的问题，扣的钱不算少。",
      "prompt": "页面上那个「自己批自己」的按钮，你会按下它吗？",
      "options": [
        {
          "key": "A",
          "text": "三次全补。这套制度本来就没打算跟人讲道理，能过就过。",
          "effects": {
            "dd_order": -1.9,
            "dd_good": -1.5,
            "sin_greed": 1.0
          },
          "social_desirability": 0
        },
        {
          "key": "B",
          "text": "关掉页面，走正常的补卡流程，批不批由组长自己判断。",
          "effects": {
            "dd_order": 1.9,
            "dd_good": 1.3,
            "light_kant": 1.0
          },
          "social_desirability": 2
        },
        {
          "key": "C",
          "text": "照扣，然后把三次截图发给组长，请全组按同一套标准来。",
          "effects": {
            "dd_order": 1.9,
            "dd_good": -1.2,
            "val_standard": 1.0
          },
          "social_desirability": 1
        },
        {
          "key": "D",
          "text": "三次都补，然后把入口告诉全组——凭什么只有我一个人知道。",
          "effects": {
            "dd_order": -1.2,
            "dd_good": 1.2,
            "mot_belonging": 0.9
          },
          "social_desirability": 1
        }
      ]
    },
