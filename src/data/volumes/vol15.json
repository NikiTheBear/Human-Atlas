  "questions": [
    {
      "id": "v15_q01",
      "type": "forced_choice",
      "stealth_mode": "ipsative",
      "layer": "explicit",
      "mirror_key": "tki_competing",
      "is_sensitive": true,
      "weight": 1.4,
      "context": "你加班到十点回家。厨房水槽里堆着中午的碗，对方靠在沙发上看剧。你说了一句「碗能不能顺手洗掉」，他抬了下头，回了一句。",
      "prompt": "那句话落地的两秒里，你嘴里最先冲出来的是哪一句？",
      "options": [
        {
          "key": "A",
          "text": "「我衣服是堆了三天，我说的今天是这口碗。两件事别混着算，我们只谈这一件。」",
          "effects": {
            "pac_adult": 1.8,
            "tki_collaborating": 1.6,
            "cog_independent": 0.8,
            "light_kant": 0.6
          },
          "social_desirability": 3
        },
        {
          "key": "B",
          "text": "「我一天到晚挑毛病？那这个月你洗过几次碗，现在就把数摆出来。」",
          "effects": {
            "tki_competing": 1.9,
            "pac_parent": 1.6,
            "def_attack": 1.2,
            "sin_wrath": 0.8
          },
          "social_desirability": 0
        },
        {
          "key": "C",
          "text": "「行，那我洗。」说完走去拧开水龙头，背对着他把碗一个个冲干净。",
          "effects": {
            "tki_accommodating": 1.9,
            "pac_child": 1.4,
            "def_fawn": 1.2,
            "big5_compliance": 1.0
          },
          "social_desirability": 1
        },
        {
          "key": "D",
          "text": "「算了，你继续看吧。」把包放下，转身进卧室关上门，今晚不再多说一个字。",
          "effects": {
            "tki_avoiding": 1.9,
            "pac_child": 1.2,
            "def_detach": 1.4,
            "big5_rumination": 0.8
          },
          "social_desirability": 1
        }
      ]
    },
    {
